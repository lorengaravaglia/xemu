<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.boxxy">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".XemuApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xemu">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Frontends (ES-DE): ACTION_VIEW with the disc as a content URI.
             Its own affinity and no history, so it never joins or lingers
             in Boxxy's task; see ExternalLaunchActivity. -->
        <activity
            android:name=".ExternalLaunchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.boxxy.external"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-iso9660-image" />
            </intent-filter>
        </activity>

        <activity
            android:name=".emulation.EmulationActivity"
            android:configChanges="orientation|screenSize"
            android:launchMode="singleTask"
            android:exported="false"
            android:gwpAsanMode="never"
            android:memtagMode="off"
            android:process=":EmulationProcess"
            android:screenOrientation="landscape" />

        <activity
            android:name=".emulation.MappingActivity"
            android:exported="false"
            android:process=":EmulationProcess"
            android:screenOrientation="landscape" />

    </application>
</manifest>
